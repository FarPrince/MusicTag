<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MusicTag.Core\MusicTag.Core.csproj" />
    <!-- App.ResolveStartupFolder is pure path logic with no Avalonia runtime dependency, so it's
         safe to unit test directly (via InternalsVisibleTo) despite MusicTag.App otherwise having
         no UI-thread test host — see AppResolveStartupFolderTests. -->
    <ProjectReference Include="..\MusicTag.App\MusicTag.App.csproj" />
  </ItemGroup>

</Project>
